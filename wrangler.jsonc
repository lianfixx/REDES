// Panel de la Matriz de Redes en Cloudflare Workers. Lo publica .github/workflows/publicar-panel.yml.
{
  "name": "redes",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [{ "binding": "REDES", "id": "69a752d292f54583b4892fbcaccbc6e9" }],
  // PANEL guarda todo el estado (piezas, notas, credenciales cifradas) con consistencia fuerte; KV queda solo para migrar.
  "durable_objects": { "bindings": [{ "name": "INTENTOS", "class_name": "Intentos" }, { "name": "PANEL", "class_name": "Panel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Intentos"] }, { "tag": "v2", "new_sqlite_classes": ["Panel"] }],
  // Cada 5 minutos: publica lo programado y lee métricas de X a las 48 h y a los 7 días.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "TOPE_X_USD": "10", "LINKEDIN_VERSION": "202510" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true }
}
